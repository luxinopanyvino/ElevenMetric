# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local data: the database, uploaded media and fitted model artefacts are all
# regenerable (`python -m app.db.seed --reset`) and must not be committed.
data/*.db
data/*.db-shm
data/*.db-wal
data/media/
data/models/
# Responses cached from external sources. Regenerable, potentially large, and
# someone else's content — see docs/EXTERNAL_SOURCES.md.
data/external-cache/

# Environment
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store

# graphify — commit only the graph artefacts; everything else in graphify-out/
# is machine-specific state, caches or bookkeeping and is regenerable.
graphify-out/*
!graphify-out/graph.html
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
# stray extraction caches graphify may drop next to source files
backend/**/graphify-out/
